# =====================================================================
# GameScope Live — Production Backend Environment Variables
# =====================================================================

PORT=5000
NODE_ENV=production

# URLs & Allowed CORS Origins (Comma-separated)
CLIENT_URL=https://live.5tart.sbs
ADMIN_URL=https://gamescopeserver.5tart.sbs
CORS_ORIGINS=https://live.5tart.sbs,https://gamescopeserver.5tart.sbs,http://localhost:5174,http://localhost:5175,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Admin Authentication & Allowlist
# Comma-separated list of authorized administrator Google/Firebase emails
ADMIN_EMAILS=admin@gamescope.live,producer@gamescope.live,director@gamescope.live
ADMIN_SECRET=gamescope_admin_master_secret_2026
JWT_SECRET=gamescope_jwt_secure_session_token_key_leonida

# Firebase Admin SDK Configuration
# Option 1: File path to service account key JSON
GOOGLE_APPLICATION_CREDENTIALS=
# Option 2: Environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push API (VAPID) Credentials for Browser Push Notifications
# Generated via npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBKr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxI4O8W9bNn4V580t6f8R1a5qZkK9M0pP3y7w1L5oE
VAPID_SUBJECT=mailto:contact@gamescope.live

# Defaults
DEFAULT_EVENT_ID=gta-vi-premiere-2026
DEFAULT_YOUTUBE_VIDEO_ID=QdBZY2fkU-0

# YouTube Data API v3 & Live Chat Integration (Render Environment)
YOUTUBE_API_KEY=
YOUTUBE_DEFAULT_VIDEO_ID=BGUTv2K_SWs
YOUTUBE_CHAT_IMPORT_ENABLED=true
